{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "dev:devices": "node scripts/dev.mjs --host 0.0.0.0",
    "simulator:open": "node scripts/open-simulator.mjs",
    "ios:sync": "node scripts/sync-icon.mjs --if-needed && npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "node scripts/run-ios.mjs",
    "dev:web": "vite",
    "backend": "node --env-file-if-exists=.env.local backend/server.mjs",
    "test": "node --test backend/*.test.mjs",
    "ios:live": "node scripts/run-ios.mjs --live",
    "typecheck": "tsc --noEmit --noUnusedLocals false --noUnusedParameters false",
    "ios:icon": "node scripts/sync-icon.mjs",
    "dev:ios": "node scripts/dev-ios.mjs",
    "dev:admin": "vite --config admin/vite.config.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:all": "npm run build && npm run build:admin",
    "dev:all": "node scripts/dev.mjs --admin",
    "start:frontend": "node scripts/start-service.mjs frontend",
    "start:admin": "node scripts/start-service.mjs admin",
    "start:backend": "node scripts/start-service.mjs backend",
    "mongo:backup": "node scripts/mongo-backup.mjs backup",
    "seed:community": "node scripts/seed-community.mjs",
    "check:acceptance": "node scripts/evaluate-community.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "esbuild": "0.25.12",
    "lucide-react": "^0.487.0",
    "mongodb": "^7.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^7.0.2",
    "vite": "6.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
