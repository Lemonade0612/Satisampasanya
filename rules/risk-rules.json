    {
      "id": "free_bundle",
      "category": "scam",
      "weight": 6,
      "hard_red": true,
      "patterns": [
        "free\\s+(visa|flights?|airfare|tuition|accommodation|housing)[\\s\\S]{0,80}free\\s+(visa|flights?|airfare|tuition|accommodation|housing)",
        "ຟຣີ[\\s\\S]{0,40}(ວີຊາ|ປີ້ຍົນ|ຄ່າຮຽນ|ທີ່ພັກ)[\\s\\S]{0,60}ຟຣີ"
      ],
      "reason": {
        "en": "Offers a bundle of free visa, flights, tuition or housing",
        "lo": "ສະເໜີຊຸດ ວີຊາ, ປີ້ຍົນ, ຄ່າຮຽນ ຫຼື ທີ່ພັກ ຟຣີ"
      }
    },
    {
