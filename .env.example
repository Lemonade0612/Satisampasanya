# Simulator API (default); a physical phone needs your Mac's LAN address.
# VITE_API_URL=http://127.0.0.1:3001/api
# API_HOST=127.0.0.1
# API_PORT=3001
# ALLOWED_ORIGINS=http://192.168.1.20:5173
# SEED_DEMO=false

# Optional: real AI screening and automatic English/Lao translation.
# Never prefix this key with VITE_; it must stay in the backend.
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4.1-mini

# Existing registered accounts allowed to access /admin (comma-separated).
ADMIN_EMAILS=

# Optional Atlas backups: SQLite remains the live app database.
# Enter a complete URI privately; never use the password shared in chat.
# MONGODB_URI=mongodb+srv://USERNAME:NEW_PASSWORD@cluster0.gcc0es9.mongodb.net/sati
# MONGODB_DATABASE=sati

# Local NLLB translation + DeBERTa screening service
NLLB_URL=http://127.0.0.1:3002

# Hosted Ask/Check model; NLLB remains the translation service.
# OPENAI_API_KEY must be set privately in .env.local.
LOCAL_HELPLINES=[]

# OpenRouter alternative for hosted Ask/Check.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Separate hosted app/admin sites; each can proxy /api to the same backend.
# VITE_APP_URL=https://app.example.com
# VITE_API_URL=https://api.example.com/api
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Browser visits to the API root open the separate admin workspace.
# ADMIN_URL=https://admin.example.com

# iOS push notifications (APNs). Without these, alerts stay in-app only.
# Create a key at developer.apple.com > Keys with "Apple Push Notifications service".
# APNS_KEY_FILE=/absolute/path/AuthKey_ABC123DEFG.p8
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=YOURTEAMID
# APNS_BUNDLE_ID=la.satisampasanya.app
# APNS_ENV=development   # use production for TestFlight/App Store builds
