{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sati: iPhone + backend (Device Hub)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev-ios.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Sati: App + backend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--open",
        "/"
      ]
    },
    {
      "name": "Sati: Admin + backend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev.mjs",
      "args": [
        "--admin"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Sati: iPhone live (Device Hub)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run-ios.mjs",
      "args": [
        "--live"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Sati: Backend only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/backend/server.mjs",
      "envFile": "${workspaceFolder}/.env.local",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Sati: Admin only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": [
        "--config",
        "admin/vite.config.ts",
        "--open"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Sati: Frontend only",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": [
        "--open"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
